#!/bin/bash
# Boot-time hardware bring-up. Installed by deploy/provision.sh, run by
# curing-hw.service as a oneshot before the application. Idempotent. It loads
# device tree overlays at runtime so /boot/firmware stays untouched.
set -u
FAN_CHANNEL=0
FAN_PERIOD_NS=40000   # 25 kHz
RP1_PWM0=1f00098000.pwm
OVERLAY_DIR=/opt/curing/overlays
fail=0
log() { echo "curing-hw-init: $*"; }

# Earliest software view of the output lines on each boot, before anything changes them.
log "uptime=$(cut -d' ' -f1 /proc/uptime) lines at start of bring-up:"
for p in 12 17 22 23 24 25 27; do log "  $(pinctrl get "$p")"; done

# 1. Relays first. A freed RP1 line must not keep driving: with
# persist_gpio_outputs=N the kernel drops its output enable when its owner dies,
# so the pull-down turns the relay off. Then force the lines to input with
# pull-down in case anything left them driven.
if [ -w /sys/module/pinctrl_rp1/parameters/persist_gpio_outputs ]; then
  echo N > /sys/module/pinctrl_rp1/parameters/persist_gpio_outputs || { log "persist_gpio_outputs write failed"; fail=1; }
else
  log "persist_gpio_outputs not writable"; fail=1
fi
/opt/curing/libexec/curing-safe-outputs || fail=1

# 2. Overlays via configfs.
loaded=$(dtoverlay -l 2>/dev/null)
apply() { # <name> <directory or empty> [params...]
  local name="$1" dir="$2"; shift 2
  if grep -qE "^[0-9]+: +$name( |\$)" <<<"$loaded"; then log "overlay $name already loaded"; return 0; fi
  if [ -n "$dir" ]; then dtoverlay -d "$dir" "$name" "$@"; else dtoverlay "$name" "$@"; fi || { log "overlay $name failed"; fail=1; return 1; }
  log "overlay $name loaded"
}
modprobe i2c-dev || { log "modprobe i2c-dev failed"; fail=1; }
apply i2c1-pi5 "" baudrate=100000
apply dht11 "" gpiopin=4
apply curing-fan "$OVERLAY_DIR"
udevadm settle --timeout=5 || true
# The overlay leaves the DHT pad unpulled. A weak pull-up keeps an empty connector
# from floating; modules carry their own stronger pull-up. After settle, because
# the driver's probe applies the overlay's pin state.
pinctrl set 4 pu || fail=1

# 3. PWM channel for the fan: 25 kHz, duty 0, enabled, writable by group gpio.
chip=""
for i in $(seq 1 30); do
  for c in /sys/class/pwm/pwmchip*; do
    case "$(readlink -f "$c")" in *"/$RP1_PWM0/"*) chip="$c" ;; esac
  done
  [ -n "$chip" ] && break
  sleep 0.1
done
if [ -z "$chip" ]; then
  log "RP1 PWM0 ($RP1_PWM0) did not appear"; fail=1
else
  ch="$chip/pwm$FAN_CHANNEL"
  [ -d "$ch" ] || echo "$FAN_CHANNEL" > "$chip/export"
  for i in $(seq 1 30); do [ -w "$ch/period" ] && break; sleep 0.1; done
  echo 0 > "$ch/duty_cycle" 2>/dev/null || true
  echo "$FAN_PERIOD_NS" > "$ch/period" || { log "PWM period write failed"; fail=1; }
  echo 0 > "$ch/duty_cycle" || fail=1
  echo normal > "$ch/polarity" 2>/dev/null || true
  echo 1 > "$ch/enable" || { log "PWM enable failed"; fail=1; }
  chgrp gpio "$ch/duty_cycle" "$ch/period" "$ch/enable" "$ch/polarity" && chmod g+rw "$ch/duty_cycle" "$ch/period" "$ch/enable" "$ch/polarity" || fail=1
  log "PWM $ch period=$(cat "$ch/period") duty=$(cat "$ch/duty_cycle") enable=$(cat "$ch/enable")"
fi

# 4. Free the display. getty@tty1 is masked by provisioning; detach fbcon so
# kernel messages and the cursor do not draw over the panel. cmdline.txt keeps
# console=tty1 because /boot/firmware is off limits. The panel driver loads
# through udev, so wait for it.
#
# Some boots the firmware's display_auto_detect misses the panel: it then loads no
# panel overlay and leaves DSI0 disabled, and the panel stays blank until a power
# cycle. Loading the same overlay at runtime brings it up (docs/adr/0209). The
# decision rests on the device tree, not on a timeout: only when the firmware left
# DSI0 disabled and no panel overlay is loaded.
DSI0=/proc/device-tree/axi/pcie@1000120000/rp1/dsi@110000
if [ "$(tr -d '\0' < "$DSI0/status" 2>/dev/null)" = disabled ] && ! dtoverlay -l 2>/dev/null | grep -q vc4-kms-dsi-7inch; then
  echo "<4>curing-hw-init: firmware did not enable the panel; loading vc4-kms-dsi-7inch dsi0 at runtime"
  if dtoverlay vc4-kms-dsi-7inch dsi0; then
    echo runtime > /run/curing-panel-overlay
  else
    echo "<2>curing-hw-init: runtime panel overlay failed"
  fi
fi
for i in $(seq 1 100); do [ -e /dev/fb0 ] && grep -qs ft5x06 /proc/bus/input/devices && grep -qs 'frame buffer' /sys/class/vtconsole/vtcon*/name && break; sleep 0.2; done
# Not a bring-up failure: relays and the guard do not need a display.
/opt/curing/libexec/curing-display-status
for v in /sys/class/vtconsole/vtcon*; do
  if grep -q 'frame buffer' "$v/name" 2>/dev/null; then echo 0 > "$v/bind" || { log "fbcon unbind failed"; fail=1; }; fi
done
dmesg -n 1 || true
exit $fail
