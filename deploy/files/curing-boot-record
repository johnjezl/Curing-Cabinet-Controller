#!/bin/bash
# Keeps one small record per boot in its own directory, so that unclean resets
# cannot push fault history out. journald's corrupt-file renames eat its size cap;
# these files are outside it. Records of unclean boots are never evicted by clean
# ones. See docs/adr/0204.
set -u
DIR="${CURING_RECORD_DIR:-/var/lib/curing-records}"
DT="${CURING_DT_DIR:-/proc/device-tree/chosen}"
BOOT_ID_FILE="${CURING_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}"
KEEP_UNCLEAN="${CURING_KEEP_UNCLEAN:-200}"
KEEP_CLEAN="${CURING_KEEP_CLEAN:-50}"
MAX_SECTION_BYTES=32768

mkdir -p "$DIR"
cd "$DIR" || exit 1
boot_id=$(cat "$BOOT_ID_FILE")

dt_hex() { od -An -tx1 "$DT/$1" 2>/dev/null | tr -d ' \n'; }

case "${1:-}" in
  mark-clean)
    echo "$boot_id" > clean-shutdown
    sync
    exit 0
    ;;
  start) ;;
  *) echo "usage: curing-boot-record start|mark-clean" >&2; exit 2 ;;
esac

prev=$(cat last-boot-id 2>/dev/null || true)
marker=$(cat clean-shutdown 2>/dev/null || true)
if [ -z "$prev" ]; then
  class=first
elif [ "$prev" = "$boot_id" ]; then
  exit 0 # restarted within one boot: this boot already has its record
elif [ "$marker" = "$prev" ]; then
  class=clean
else
  class=unclean
fi

seq=$(( $(cat seq 2>/dev/null || echo 0) + 1 ))
echo "$seq" > seq
now=$(date -u +%Y%m%dT%H%M%SZ)
rsts=$(dt_hex bootloader/rsts); power_reset=$(dt_hex power/power_reset)
rtc=$(cat /sys/class/rtc/rtc0/since_epoch 2>/dev/null || echo unknown)
sync_state=$(timedatectl show -p NTPSynchronized --value 2>/dev/null || echo unknown)
uptime_s=$(cut -d' ' -f1 /proc/uptime)

file="$(printf '%06d' "$seq")-$class-$now.txt.gz"
{
  echo "boot_id=$boot_id"
  echo "previous_boot_id=$prev"
  echo "previous_shutdown=$class"
  echo "reset_status_rsts=$rsts"
  echo "power_reset=$power_reset"
  echo "system_clock_utc=$now"
  echo "rtc_epoch=$rtc"
  echo "ntp_synchronized=$sync_state"
  echo "uptime_s=$uptime_s"
  echo "== previous boot, warnings and above"
  journalctl --no-pager -b -1 -p warning -n 200 2>&1 | tail -c "$MAX_SECTION_BYTES"
  echo "== previous boot, last entries"
  journalctl --no-pager -b -1 -n 200 2>&1 | tail -c "$MAX_SECTION_BYTES"
} | gzip -c > "$file.tmp"
mv "$file.tmp" "$file"
echo "$seq $now class=$class boot=$boot_id prev=$prev rsts=$rsts power_reset=$power_reset rtc=$rtc ntp=$sync_state uptime=$uptime_s" >> index.log
tail -n 5000 index.log > index.log.tmp && mv index.log.tmp index.log
echo "$boot_id" > last-boot-id
: > clean-shutdown

prune() { # <class pattern> <keep>; works on bare names in the record directory
  ls -1 | grep -E "^[0-9]+-($1)-" | sort | head -n "-$2" | xargs -r rm -f --
}
prune 'clean|first' "$KEEP_CLEAN"
prune unclean "$KEEP_UNCLEAN"
sync
echo "curing-boot-record: record $seq, previous shutdown $class, rsts=$rsts"
