[Unit]
Description=Curing cabinet controller, SIMULATED PLANT (bench only)
After=curing-hw.service curing-outputd.service
Wants=curing-hw.service curing-outputd.service
Conflicts=curing.service
ConditionPathExists=/etc/curing/sim.env
ConditionPathExists=!/etc/curing/production
ConditionFileIsExecutable=/opt/curing/bin/cured
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=curing
Group=curing
# No gpio or i2c: a simulation never touches a line or a sensor (ADR 0406).
SupplementaryGroups=video input render tty
StateDirectory=curing-sim
StateDirectoryMode=0750
RuntimeDirectory=curing-cured
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
WorkingDirectory=/var/lib/curing-sim
EnvironmentFile=/etc/curing/sim.env
ExecStart=/opt/curing/bin/cured --sim --speed ${SIM_SPEED} --sim-outage ${SIM_OUTAGE} --sim-confirm=not-a-real-cabinet
ExecStopPost=-/opt/curing/bin/cured post-stop --sim
WatchdogSec=10s
TimeoutAbortSec=3s
TimeoutStartSec=120s
TimeoutStopSec=60s
Restart=always
RestartSec=1s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
